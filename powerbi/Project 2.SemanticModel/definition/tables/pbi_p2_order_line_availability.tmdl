	partition pbi_p2_order_line_availability = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("DESKTOP-4F2KL18\MSSQLSERVER1", "SEPRO_Master_Prod", [Query="SELECT#(lf)    sol.sales_order_line_id,#(lf)    so.sales_order_id,#(lf)    so.customer_key,#(lf)    so.order_date_key,#(lf)    so.order_date,#(lf)    so.requested_delivery_date,#(lf)#(lf)    sol.product_key,#(lf)    sol.quantity_ordered,#(lf)#(lf)    ni.network_on_hand_qty,#(lf)    ni.network_available_qty,#(lf)#(lf)    CASE#(lf)        WHEN ni.product_key IS NULL#(lf)            THEN 'Missing snapshot'#(lf)#(lf)        WHEN ni.network_available_qty >= sol.quantity_ordered#(lf)            THEN 'Available in full'#(lf)#(lf)        WHEN ni.network_available_qty > 0#(lf)            THEN 'Partially available'#(lf)#(lf)        ELSE 'No stock'#(lf)    END AS line_availability_group,#(lf)#(lf)    f.quantity_shipped_total,#(lf)    f.line_complete_flag,#(lf)    f.line_on_time_flag,#(lf)    f.completion_delivery_date,#(lf)    f.late_delivery_days#(lf)#(lf)FROM gold.fact_sales_order_line AS sol#(lf)#(lf)INNER JOIN gold.fact_sales_order AS so#(lf)    ON so.sales_order_id = sol.sales_order_id#(lf)#(lf)LEFT JOIN#(lf)(#(lf)    SELECT#(lf)        snapshot_date_key,#(lf)        product_key,#(lf)        SUM(available_qty) AS network_available_qty,#(lf)        SUM(on_hand_qty) AS network_on_hand_qty#(lf)    FROM gold.fact_inventory_snapshot#(lf)    GROUP BY#(lf)        snapshot_date_key,#(lf)        product_key#(lf)) AS ni#(lf)    ON ni.snapshot_date_key = so.order_date_key#(lf)   AND ni.product_key = sol.product_key#(lf)#(lf)LEFT JOIN gold.fact_fulfillment AS f#(lf)    ON f.sales_order_line_id = sol.sales_order_line_id"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

