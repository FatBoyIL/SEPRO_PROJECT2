	partition pbi_p2_supplier_line_performance = m
		mode: directQuery
		source =
				let
				    Source =
				        Sql.Database(
				            "DESKTOP-4F2KL18\MSSQLSERVER1",
				            "SEPRO_Master_Prod",
				            [
				                Query = "
				SELECT
				    pol.purchase_order_line_id,
				    pol.purchase_order_id,
				
				    ds.supplier_key,
				    dp.product_key,
				    dd.date_key AS po_date_key,
				
				    po.po_date,
				    po.expected_receipt_date,
				    po.actual_receipt_date,
				    po.po_status,
				
				    pol.quantity_ordered,
				
				    pol.merchandise_value_vnd AS merchandise_cost_vnd,
				    pol.freight_cost_vnd,
				    pol.customs_cost_vnd,
				    pol.expedite_cost_vnd,
				
				    pol.merchandise_value_vnd
				        + pol.freight_cost_vnd
				        + pol.customs_cost_vnd
				        + pol.expedite_cost_vnd AS procurement_cost_vnd,
				
				    CASE
				        WHEN po.po_status = 'Received'
				        THEN 1 ELSE 0
				    END AS received_flag,
				
				    CASE
				        WHEN po.po_status = 'Received'
				         AND po.actual_receipt_date <= po.expected_receipt_date
				        THEN 1 ELSE 0
				    END AS timely_receipt_flag,
				
				    CASE
				        WHEN po.po_status = 'Received'
				        THEN DATEDIFF(DAY, po.po_date, po.actual_receipt_date)
				        ELSE 0
				    END AS actual_lead_time_days,
				
				    CASE
				        WHEN po.po_status = 'Received'
				         AND po.actual_receipt_date > po.expected_receipt_date
				        THEN DATEDIFF(
				            DAY,
				            po.expected_receipt_date,
				            po.actual_receipt_date
				        )
				        ELSE 0
				    END AS late_receipt_days
				
				FROM silver.purchase_order_lines AS pol
				
				INNER JOIN silver.purchase_orders AS po
				    ON pol.purchase_order_id = po.purchase_order_id
				
				LEFT JOIN gold.dim_supplier AS ds
				    ON po.supplier_id = ds.supplier_id
				
				LEFT JOIN gold.dim_product AS dp
				    ON pol.product_id = dp.product_id
				
				LEFT JOIN gold.dim_date AS dd
				    ON po.po_date = dd.[date]
				"
				            ]
				        )
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

